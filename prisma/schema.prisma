// Egyptian Judicial Brain V2.1 — Sovereign Court-Pilot Data Model
// Judicial Evidence–Law–Authority–Temporal–Reasoning Control System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── CASE INTELLIGENCE ENGINE (§18) ──────────────────────────────
model Case {
  id              String   @id @default(cuid())
  caseNumber      String   @unique
  title           String
  court           String
  circuit         String
  caseType        String
  parties         String
  subjectMatter   String
  proceduralStage String   // FILED, REGISTERED, SERVICE, PLEADINGS, EVIDENCE, EXPERT, HEARING, DELIBERATION, JUDGMENT, APPEAL, FINALITY, EXECUTION
  riskLevel       String   // LOW, MEDIUM, HIGH, CRITICAL
  operatingState  String   // NOMINAL, REVIEW, INSUFFICIENT_EVIDENCE, CONFLICT, SYSTEM_DEGRADED
  summary         String
  filedDate       DateTime?
  nextHearing     DateTime?
  aiSyncEnabled   Boolean  @default(false)
  corpusVersion   String   @default("EJB-CORPUS-2026.08-R1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facts        Fact[]
  evidence     Evidence[]
  timeline     TimelineEvent[]
  issues       LegalIssue[]
  authorities  Authority[]
  judgeFields  JudgeField[]
  aiAnalyses   AIAnalysis[]
  indicators   Indicator[]
  conflicts       Conflict[]
  adversaryReviews AdversaryReview[]
  notes           JudgeNote[]
  auditLogs       AuditLog[]
  citationVerifications CitationVerification[]
  deadlines       CaseDeadline[]
  documents       StoredDocument[]

  @@index([proceduralStage])
  @@index([riskLevel])
  @@index([operatingState])
}

// ─── FACT-STATE ENGINE (§19) ─────────────────────────────────────
// Status: alleged, admitted, denied, undisputed, supported, contradicted,
//         judicially_established, unresolved, immaterial, procedurally_irrelevant
// Materiality: outcome_material, supporting, immaterial (§27)
model Fact {
  id           String   @id @default(cuid())
  caseId       String
  statement    String
  status       String   @default("unresolved")
  materiality  String   @default("supporting")
  party        String?
  sourceNote   String?
  aiExtracted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([status])
}

// ─── EVIDENCE INTELLIGENCE ENGINE (§20, §21) ─────────────────────
// type: document | digital
// evidenceType: contract, email, message, pdf, spreadsheet, image, video, audio, signature, scan
// admissibility: admissible, challenged, excluded, pending_review
// judicialTreatment: unexamined, accepted, rejected, weighed
model Evidence {
  id                String   @id @default(cuid())
  caseId            String
  title             String
  type              String   @default("document")
  evidenceType      String
  origin            String?
  source            String?
  date              DateTime?
  integrityHash     String?
  admissibility     String   @default("pending_review")
  judicialTreatment String   @default("unexamined")
  relevance         String?
  metadata          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([type])
}

// ─── LEGAL TEMPORAL ENGINE (§13) ─────────────────────────────────
// eventType: contract, transaction, breach, discovery, filing, notice,
//            amendment, service, procedural_order, hearing, judgment, appeal, execution
model TimelineEvent {
  id          String   @id @default(cuid())
  caseId      String
  title       String
  description String?
  eventDate   DateTime
  eventType   String
  legalRegime String?
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([eventDate])
}

// ─── LEGAL ISSUE ENGINE (§25) — hierarchical issue tree ──────────
// issueType: jurisdiction, admissibility, procedural, primary, defense,
//            counterclaim, constitutional, remedy
model LegalIssue {
  id          String   @id @default(cuid())
  caseId      String
  title       String
  description String?
  issueType   String
  status      String   @default("open") // open, resolved, unresolved, blocked
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([parentId])
}

// ─── LEGAL AUTHORITY ENGINE (§8, §9) ─────────────────────────────
// stance: supporting | opposing | contrary | distinguishing | neutral
// legalForce: constitutional_provision, statute, regulation, executive_decision,
//             constitutional_judgment, judicial_principle, court_judgment,
//             state_council_opinion, administrative_interpretation, verified_secondary,
//             academic_commentary, research_only
model Authority {
  id                  String   @id @default(cuid())
  caseId              String
  title               String
  issuingAuthority    String?
  judicialBody        String?
  court               String?
  chamber             String?
  documentType        String?
  legalDomain         String?
  jurisdiction        String?
  citation            String?
  referenceDate       DateTime?
  stance              String   @default("supporting")
  authorityStatus     String   @default("active") // active, superseded, repealed, archived
  legalForce          String   @default("court_judgment")
  temporalStatus      String   @default("current") // current, historical, transitional
  sourceTier          Int      @default(3)
  verificationStatus  String   @default("verified") // verified, partially_verified, unverified, blocked
  exactPassage        String?
  sourceUrl           String?
  relationNote        String?
  contrarySearched   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  case                Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([stance])
  @@index([verificationStatus])
}

// ─── JUDGE / AI SEPARATION (§41) ──────────────────────────────────
// fieldType: judge_results | judge_reasoning | draft | integrity_review
// status: empty | ai_proposed | judge_reviewing | judge_accepted | judge_rejected | judge_modified
model JudgeField {
  id        String   @id @default(cuid())
  caseId    String
  fieldType String
  content   String   @default("")
  status    String   @default("empty")
  updatedAt DateTime @updatedAt
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, fieldType])
  @@index([caseId])
}

// ─── AI ANALYSIS (separate from judge, §34, §66) ──────────────────
// responseStatus: verified, partially_verified, conflicted, insufficient, unverified, blocked
model AIAnalysis {
  id             String   @id @default(cuid())
  caseId         String
  analysisType   String   // summary, scenario, adversarial, jurisdiction, constitutional, procedural
  title          String
  content        String
  responseStatus String   @default("unverified")
  provenance     String?
  modelId        String   @default("sovereign-local-pool")
  nonAuthoritative Boolean @default(true)
  createdAt      DateTime @default(now())
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ─── INTEGRITY INDICATORS (§39) ──────────────────────────────────
// indicatorType: citation_soundness | legal_version | defense_coverage | evidence_consistency
model Indicator {
  id            String   @id @default(cuid())
  caseId        String
  indicatorType String
  score         Int      @default(0) // 0–100
  status        String   @default("pending") // pending, pass, warn, fail
  details       String?
  updatedAt     DateTime @updatedAt
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, indicatorType])
  @@index([caseId])
}

// ─── GOVERNANCE SETTINGS (§5, §6) ────────────────────────────────
// category: governance | law_sources | templates | model_policy
model Setting {
  id        String   @id @default(cuid())
  category  String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([category, key])
}

// ═══════════════════════════════════════════════════════════════════
// LEGAL CORPUS LAYER (§15, §16, §17) — Source Registry + Versioned Texts
// ═══════════════════════════════════════════════════════════════════

// ─── LEGAL SOURCE REGISTRY — official portals (§16) ─────────────
// sourceType: constitution | official_gazette | statute | cassation |
//             state_council | constitutional_court | specialized_court | ministry
// accessStatus: PUBLIC | AUTH_REQUIRED | PARTIAL | QUEUED | IMPORTED | VERIFIED
model LegalSource {
  id              String   @id @default(cuid())
  name            String
  nameEn          String?
  portalUrl       String?
  sourceType      String
  issuingBody     String
  jurisdiction    String?
  accessStatus    String   @default("QUEUED")
  sourceTier      Int      @default(3)
  contentAvailable String?
  accessNotes     String?
  lastChecked     DateTime?
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  legalTexts      LegalText[]

  @@index([sourceType])
  @@index([accessStatus])
  @@index([sourceTier])
}

// ─── LEGAL TEXT with temporal versioning (§14) ───────────────────
// documentType: constitutional_provision | statute_article | judgment | principle | regulation
// legalForce: constitutional_provision | statute | regulation | court_judgment | ...
// verificationStatus: verified | partially_verified | unverified | blocked
// temporalStatus: current | historical | transitional
model LegalText {
  id              String   @id @default(cuid())
  sourceId        String
  title           String
  citation        String   @unique
  documentType    String
  legalDomain     String?
  legalForce      String   @default("statute")
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  versionLabel    String
  sourceHash      String
  retrievalTimestamp DateTime @default(now())
  publicationDate DateTime?
  officialJournalRef String?
  verificationStatus String @default("verified")
  temporalStatus  String   @default("current")
  exactText       String
  sourceUrl       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  source          LegalSource @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([legalDomain])
  @@index([verificationStatus])
  @@index([temporalStatus])
}

// ─── CORPUS SNAPSHOTS — signed versioned (§46, §150) ─────────────
// approvalStatus: draft | approved | published | expired
model CorpusSnapshot {
  id              String   @id @default(cuid())
  versionLabel    String   @unique
  createdAt       DateTime @default(now())
  sourceManifest  String
  hash            String
  signature       String?
  approvalStatus  String   @default("draft")
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  textCount       Int      @default(0)
  sourceCount     Int      @default(0)
  notes           String?
}

// ─── IMPORT QUEUE for auth-required sources (§17) ─────────────────
// status: QUEUED | IN_PROGRESS | COMPLETED | FAILED | BLOCKED
model ImportJob {
  id              String   @id @default(cuid())
  sourceName      String
  sourceUrl       String?
  sourceType      String
  status          String   @default("QUEUED")
  priority        Int      @default(5)
  requiresAuth    Boolean  @default(false)
  authType        String?
  lastAttempt     DateTime?
  contentScope    String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// CONFLICT ENGINE (§29, §30) — POTENTIAL_CONFLICT → CONFLICT (validated)
// ═══════════════════════════════════════════════════════════════════
// conflictType: factual | temporal | jurisdictional | legal | procedural | draft
// status: POTENTIAL_CONFLICT | CONFLICT | RESOLVED | FALSE_POSITIVE
// judgeReview: pending | reviewed | dismissed | confirmed
model Conflict {
  id              String   @id @default(cuid())
  caseId          String
  conflictType    String
  status          String   @default("POTENTIAL_CONFLICT")
  authorityAId    String?
  authorityBId    String?
  description     String
  significance    String?
  explanation     String?
  judgeReview     String   @default("pending")
  createdAt       DateTime @default(now())
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([conflictType])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════
// ADVERSARY REVIEW — The Judicial Shadow (§34, §36)
// Tests each result from 4 angles WITHOUT issuing a verdict
// ═══════════════════════════════════════════════════════════════════
// targetType: ai_analysis | fact | authority | judge_field | proposition
// transferStatus: none | requested | transferred | rejected
model AdversaryReview {
  id              String   @id @default(cuid())
  caseId          String
  targetType      String
  targetId        String?
  proposition     String
  factsAngle      String
  textAngle       String
  defenseAngle    String
  proceduralAngle String
  vulnerabilities String?
  transferStatus  String   @default("none")
  transferredAt   DateTime?
  judgeNote       String?
  createdAt       DateTime @default(now())
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([targetType])
  @@index([transferStatus])
}

// ═══════════════════════════════════════════════════════════════════
// JUDGE NOTES — free-form, linkable to items
// ═══════════════════════════════════════════════════════════════════
// itemType: fact | evidence | authority | issue | adversary | general
model JudgeNote {
  id              String   @id @default(cuid())
  caseId          String
  itemType        String   @default("general")
  itemId          String?
  content         String
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([itemType])
}

// ═══════════════════════════════════════════════════════════════════
// AUDIT LOG — immutable, separates system proposals from judge decisions (§87)
// ═══════════════════════════════════════════════════════════════════
// actor: system | judge | rapporteur | administrator
// source: system_proposal | judge_decision | system_action | audit | adversary_transfer
model AuditLog {
  id              String   @id @default(cuid())
  caseId          String?
  actor           String   @default("system")
  action          String
  entityType      String
  entityId        String?
  source          String   @default("system_action")
  details         String?
  timestamp       DateTime @default(now())
  case            Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([source])
  @@index([timestamp])
}

// ═══════════════════════════════════════════════════════════════════
// CITATION VERIFICATION (§64) — verify against canonical source
// ═══════════════════════════════════════════════════════════════════
// verificationStatus: verified | partially_verified | unverified | blocked
model CitationVerification {
  id              String   @id @default(cuid())
  caseId          String?
  citation        String
  claimedSource   String?
  verificationStatus String @default("unverified")
  canonicalMatch  String?
  sourceHash      String?
  legalTextId     String?
  verifiedAt      DateTime @default(now())
  notes           String?
  case            Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([verificationStatus])
}

// ═══════════════════════════════════════════════════════════════════
// EGYPTIAN LEGAL DEADLINES ENGINE (قانون المرافعات + القانون المدني)
// Computes and tracks procedural deadlines per case
// ═══════════════════════════════════════════════════════════════════
// deadlineType: appeal | cassation | opposition | reconsideration |
//               prescription | service | hearing_notice | objection
// status: pending | approaching | expired | met | extended
model CaseDeadline {
  id              String   @id @default(cuid())
  caseId          String
  deadlineType    String
  title           String
  legalBasis      String
  startDate       DateTime
  computedDeadline DateTime
  daysAllowed     Int
  defendantAbroad Boolean  @default(false)
  status          String   @default("pending")
  notes           String?
  createdAt       DateTime @default(now())
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([deadlineType])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════
// DOCUMENT INGESTION & AI EXTRACTION (§22, §69, §101)
// Judge/Rapporteur uploads documents → system auto-extracts facts/timeline/citations
// All extractions are "candidate" until human verification (§60 candidate relationships)
// ═══════════════════════════════════════════════════════════════════
// uploadedBy: judge | rapporteur | administrator
// ocrStatus: pending | processing | completed | failed | not_needed
// extractionStatus: pending | processing | completed | failed | partial
// sourceType: case_file | contract | judgment | evidence | correspondence | other
model StoredDocument {
  id              String   @id @default(cuid())
  caseId          String
  originalName    String
  storedName      String
  mimeType        String
  fileSize        Int
  uploadedBy      String   @default("rapporteur")
  sourceType      String   @default("case_file")
  ocrStatus       String   @default("pending")
  ocrText         String?
  ocrConfidence   Float?
  extractionStatus String  @default("pending")
  extractedData   String?  // JSON: { facts: [], timeline: [], citations: [], parties: [], evidence: [] }
  extractionSummary String?
  verified        Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([uploadedBy])
  @@index([extractionStatus])
}
